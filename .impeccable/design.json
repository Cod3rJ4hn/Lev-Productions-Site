  "narrative": {
    "northStar": "The Session Sheet",
    "overview": "The site is one recording session laid out on a studio track sheet. Every section is a numbered track and scrolling works like the tape transport. Two rooms alternate: cream sheet stock for paperwork, near-black control room for the work.",
    "keyCharacteristics": [
      "Bebas Neue lettering at poster scale against calm Inter body copy",
      "Hard offset shadows on interactive things, soft tinted shadows on paper things",
      "Numbering everywhere",
      "Transform and opacity only, with a static fallback"
    ],
    "rules": [
      {
        "name": "The Marks-Not-Fields Rule",
        "body": "Orange is a mark on paper and a signal in the dark. It fills a whole region only once (the discovery band).",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Orange Rule",
        "body": "Anything set on orange is near-black, never cream or white.",
        "section": "colors"
      },
      {
        "name": "The Tight-Caps Rule",
        "body": "Display type is always uppercase with -0.03em tracking and line-height 0.9.",
        "section": "typography"
      },
      {
        "name": "The Press Rule",
        "body": "Buttons move toward their shadow when pressed; nothing glows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set text on orange in #171717.",
      "Do keep orange text only on dark grounds or at display size.",
      "Do number things (sections, lanes, takes, tape boxes).",
      "Do animate only transform and opacity, and give every moving thing a still fallback.",
      "Do give every control a hover, focus-visible and active state and a 44px target."
    ],
    "donts": [
      "Don't use rounded corners, glassmorphism or glow.",
      "Don't introduce a third typeface or a colour outside the nine tokens.",
      "Don't autoplay audio; Spotify loads only on a click.",
      "Don't hijack scroll: pins are bounded and native scrolling stays in charge."
    ]
  }
