  "narrative": {
    "northStar": "The Minimal Poster",
    "overview": "One loud idea per section, then air. Headlines are set in a fat poster face; everything else is quiet: flat colour fields, hairline rules, rounded photographs and a lot of empty space. The musical feeling comes from motion that responds to scroll, not from decoration.",
    "keyCharacteristics": [
      "Poster-scale Bowlby One against calm Bricolage Grotesque",
      "No boxes: structure from spacing, hairlines and colour fields",
      "Pills for actions, generous rounding for photographs",
      "Transform and opacity only, with a static fallback"
    ],
    "rules": [
      {
        "name": "The Big-Or-Absent Rule",
        "body": "Orange is either a large field or large type, or it is not on the screen. Small orange text appears only on black.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Orange Rule",
        "body": "Anything set on an orange fill is near-black.",
        "section": "colors"
      },
      {
        "name": "The One-Face-Per-Job Rule",
        "body": "Bowlby sets headings, prices and names only. Never body copy.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do give each section one big type moment and leave the rest empty.",
      "Do set text on orange in #171717.",
      "Do animate only transform and opacity, and give every moving thing a static fallback.",
      "Do keep every control at 44px or larger with hover, focus-visible and active states."
    ],
    "donts": [
      "Don't put content in boxes or cards; use space, a hairline or a colour change.",
      "Don't add decorative motion that carries no information (no tickers, no spinning props).",
      "Don't autoplay audio; Spotify loads only on a click.",
      "Don't introduce another typeface or colour outside the palette."
    ]
  }
