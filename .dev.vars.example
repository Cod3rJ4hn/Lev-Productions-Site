# Copy to .dev.vars and fill in for local dev. .dev.vars is gitignored.
# In production these are set with: npx wrangler pages secret put NAME

# Spam protection (Cloudflare Turnstile). For local testing Cloudflare publishes
# a dummy secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Email (Resend)
EMAIL_API_KEY=
NOTIFY_EMAIL=
# Optional: a verified sender, e.g. "LevProductions <hello@levproductions.com.au>"
EMAIL_FROM=
